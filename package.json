{
  "name": "shefin-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start:server": "NODE_ENV=production node server/index.js",
    "start:client": "npm --prefix client run start",
    "start": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run start:server\" \"npm run start:client\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}

